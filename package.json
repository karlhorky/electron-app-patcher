{
  "name": "electron-app-patcher",
  "version": "1.0.0",
  "repository": "git@github.com:karlhorky/electron-app-patcher.git",
  "license": "MIT",
  "author": "Karl Horky <karl.horky@gmail.com>",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "patch": "node --loader ts-node/esm index.ts"
  },
  "dependencies": {
    "@electron/asar": "4.3.1",
    "ts-node": "10.9.2"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "eslint": "10.11.0",
    "eslint-config-upleveled": "11.0.1",
    "typescript": "5.9.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.26.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.13"
  }
}
