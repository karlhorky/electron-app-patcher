{
  "name": "electron-app-patcher",
  "version": "1.0.0",
  "repository": "git@github.com:karlhorky/electron-app-patcher.git",
  "license": "MIT",
  "author": "Karl Horky <karl.horky@gmail.com>",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "patch": "node --import 'data:text/javascript,import { register } from \"node:module\"; import { pathToFileURL } from \"node:url\"; register(\"ts-node/esm\", pathToFileURL(\"./\"));' index.ts"
  },
  "dependencies": {
    "@electron/asar": "4.3.1",
    "ts-node": "10.9.2"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "eslint": "10.13.0",
    "eslint-config-upleveled": "11.0.3",
    "typescript": "5.9.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.13"
  }
}
