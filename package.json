{
  "name": "electron-app-patcher",
  "version": "1.0.0",
  "repository": "git@github.com:karlhorky/electron-app-patcher.git",
  "license": "MIT",
  "author": "Karl Horky <karl.horky@gmail.com>",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "patch": "node --loader ts-node/esm index.ts"
  },
  "dependencies": {
    "@electron/asar": "4.3.0",
    "ts-node": "10.9.2"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "eslint": "10.10.0",
    "eslint-config-upleveled": "10.0.4",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.26.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.13"
  }
}
